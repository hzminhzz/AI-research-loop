[Unit]
Description=AI Quant Research - ranked practitioner sources to Warden Stage 1
Documentation=https://github.com/hzminhzz/AI-research-loop
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/quant/dev/AI-research-loop
Environment=PATH=/home/quant/.local/bin:/home/quant/anaconda3/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/quant/anaconda3/bin/python -m src.social_campaign --once --output runs/social_campaign --max-screened 20 --max-daily-cycles 6
TimeoutStartSec=360
UMask=0077
Nice=10
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
